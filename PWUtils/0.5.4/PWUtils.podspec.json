{
  "name": "PWUtils",
  "version": "0.5.4",
  "summary": "Reusable Swift and Objective-C utilities and UIKit components for iOS.",
  "description": "PWUtils is an iOS component library written in Swift and Objective-C.\nIt provides reusable networking, persistence, UIKit, photo selection,\ndiagnostics, runtime, and Foundation utilities for application projects.",
  "homepage": "https://github.com/michaelssman/PWUtils",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "michael": "michael"
  },
  "source": {
    "git": "git@github.com:michaelssman/PWUtils.git",
    "tag": "0.5.4"
  },
  "platforms": {
    "ios": "12.0"
  },
  "swift_versions": [
    "5.0"
  ],
  "requires_arc": true,
  "source_files": "PWUtils/Classes/**/*.{h,m,swift}",
  "resource_bundles": {
    "PWUtils": [
      "PWUtils/Assets/*/*.{png,jpeg,jpg,imageset}"
    ]
  },
  "dependencies": {
    "Alamofire": [
      "5.10.2"
    ],
    "RxSwift": [
      "6.5.0"
    ],
    "RxCocoa": [
      "6.5.0"
    ],
    "SnapKit": [
      "5.6.0"
    ],
    "MBProgressHUD": [
      "1.2.0"
    ],
    "MJRefresh": [],
    "FMDB": []
  },
  "swift_version": "5.0"
}
